# Copy this file to .env and fill in the values.
#   PowerShell: Copy-Item .env.example .env

NODE_ENV=development
PORT=5000
# Storefront origin. Used later for CORS and links inside emails.
CLIENT_URL=http://localhost:5000

# Local MongoDB, or a MongoDB Atlas SRV connection string.
MONGO_URI=mongodb://127.0.0.1:27017/kickshub

# Long random string. Required to start the API. Example generator:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Paystack Dashboard → Settings → API Keys & Webhooks.
# Use test keys (sk_test_ / pk_test_) until the business is approved for live payments.
# Webhooks are signed with this secret key (HMAC SHA512). There is no separate webhook secret.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Nodemailer (Gmail app password, Brevo, Resend SMTP, or any SMTP host).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="KicksHub <noreply@kickshub.com>"

# Optional. Product images in the seed use Unsplash URLs.
# Admin uploads use Cloudinary when these three values are set, otherwise local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMS / WhatsApp providers. Left empty, notification hooks no-op.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=KicksHub
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=KicksHub

# How long a checkout holds stock while the customer pays. Mobile money is short
# because the networks expire the prompt in about 180 seconds.
RESERVATION_MINUTES_CARD=30
RESERVATION_MINUTES_MOMO=5

# Seed refuses to run when NODE_ENV=production unless this is true.
ALLOW_SEED=false
SEED_ADMIN_EMAIL=admin@kickshub.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_CUSTOMER_EMAIL=customer@kickshub.com
SEED_CUSTOMER_PASSWORD=Customer@123456
